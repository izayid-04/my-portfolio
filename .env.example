# -----------------------------------------------------------------------------
# Resend (Envoi d'emails transactionnels - Formulaire de Contact)
# -----------------------------------------------------------------------------
# Clé API Resend : Dashboard Resend → API Keys → Create API Key (format: re_xxxxxx)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Expéditeur : utiliser "onboarding@resend.dev" pour tester sans domaine personnalisé,
# ou "contact@votre-domaine.com" si vous avez validé votre propre domaine sur Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="Portfolio Iza"

# Adresse email qui recevra les messages soumis depuis le formulaire de contact
